# Copy to `.env.local` in `apps/web/portfolio/` for local Supabase connectivity.
# Leave unset or use placeholders to run safely with the built-in local fallback.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional independent product URL (leave unset until deployed, or set http://localhost:3001 locally)
# NEXT_PUBLIC_DEV_TOOLS_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
