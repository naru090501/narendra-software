# ==============================================================================
# Narendra Software — Environment Variables Example
# Copy this file to `.env.local` inside `apps/web/portfolio/` (or root as needed).
# NEVER commit `.env` or `.env.local` or expose the Supabase service-role key.
# ==============================================================================

# Public URL of the central portfolio website (used for canonical URLs & metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Independent product URLs (leave unset until deployed or set local port e.g. http://localhost:3001)
# NEXT_PUBLIC_DEV_TOOLS_URL=http://localhost:3001

# Supabase central project (`narendramain`) — Public / Anonymous client keys ONLY
# When omitted, the portfolio automatically falls back to local catalog metadata.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
