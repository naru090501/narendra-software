# ==============================================================================
# Narendra Software — Environment Variables Example
# Copy this file to `.env.local` inside `apps/web/portfolio/` (or root as needed).
# NEVER commit `.env` or `.env.local` or expose server secrets or private keys.
# ==============================================================================

# Public URL of the central portfolio website (used for canonical URLs & metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Independent product URLs (leave unset until deployed or set local port e.g. http://localhost:3001)
# NEXT_PUBLIC_DEV_TOOLS_URL=http://localhost:3001

# Supabase central project (`narendramain`) — Public / Anonymous client keys ONLY
# When omitted, the portfolio automatically falls back to local catalog metadata.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# Transactional Contact Email Delivery (SERVER-SIDE ONLY — NEVER prefix with NEXT_PUBLIC_)
# Uses standard authenticated SMTP (e.g. Gmail with App Password or custom SMTP relay)
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_SECURE=true
CONTACT_SMTP_USER=your-account@gmail.com
CONTACT_SMTP_PASS=your-16-char-app-password
CONTACT_TO_EMAIL=contact@narendrasoftware.com

# Shared Distributed Rate Limiting (SERVER-SIDE ONLY — NEVER prefix with NEXT_PUBLIC_)
# Uses Supabase PostgreSQL RPC `check_rate_limit` with atomic upserts and privacy-preserving HMAC.
# When omitted, portfolio operates in safe local in-memory fallback mode.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
RATE_LIMIT_HMAC_SECRET=your-32-char-random-hmac-salt-secret
